datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = []
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  name            String           @unique
  action          PermissionAction
  scope           PermissionScope
  resourceId      String           @map("resource_id")
  resource        Resource         @relation(fields: [resourceId], references: [id])
  rolePermissions RolePermission[]

  @@map("permissions")
}

model Resource {
  id          String       @id @default(cuid())
  code        String       @unique
  description String?
  permissions Permission[]

  @@map("resources")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@map("role_permissions")
}

// staff

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum WorkType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum StaffPosition {
  /// Cấp quản trị cao nhất
  SUPER_ADMIN

  /// Quản lý rạp phim
  CINEMA_MANAGER

  /// Phó / trợ lý quản lý rạp
  ASSISTANT_MANAGER

  /// Nhân viên bán vé
  TICKET_CLERK

  /// Nhân viên quầy bắp nước / đồ ăn
  CONCESSION_STAFF

  /// Nhân viên soát vé, hướng dẫn khách vào phòng chiếu
  USHER

  /// Nhân viên vận hành máy chiếu
  PROJECTIONIST

  /// Nhân viên vệ sinh
  CLEANER

  /// Nhân viên bảo vệ
  SECURITY
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
}

enum ClerkSyncAction {
  UPSERT
  DELETE
}

enum ClerkSyncStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
  VALIDATE
  MANAGE
}

enum PermissionScope {
  OWN
  CINEMA
  GLOBAL
}

model Staff {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cinemaId String @db.Uuid
  clerkUserId String? @unique @map("clerk_user_id")

  fullName  String        @map("full_name")
  email     String        @unique
  phone     String
  gender    Gender        @default(MALE)
  dob       DateTime
  position  StaffPosition @default(TICKET_CLERK)
  status    StaffStatus   @default(ACTIVE)
  workType  WorkType      @default(FULL_TIME)
  shiftType ShiftType     @default(MORNING)
  salary    Decimal
  hireDate  DateTime      @map("hire_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("staffs")
}

model Setting {
  key         String  @id
  value       Json    @db.JsonB
  description String?

  @@map("settings")
}

model ClerkSyncTask {
  id          String          @id @default(cuid())
  action      ClerkSyncAction
  status      ClerkSyncStatus @default(PENDING)
  syncKey     String          @unique @map("sync_key")
  payload     Json            @db.JsonB
  attempts    Int             @default(0)
  maxAttempts Int             @default(3) @map("max_attempts")
  nextRetryAt DateTime        @default(now()) @map("next_retry_at")
  lockedAt    DateTime?       @map("locked_at")
  lastError   String?         @map("last_error")
  deadLetteredAt DateTime?    @map("dead_lettered_at")
  completedAt DateTime?       @map("completed_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([status, nextRetryAt])
  @@map("clerk_sync_tasks")
}

model ClerkWebhookEvent {
  id         String   @id @default(cuid())
  eventId    String   @unique @map("event_id")
  eventType  String   @map("event_type")
  payload    Json     @db.JsonB
  processedAt DateTime @default(now()) @map("processed_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("clerk_webhook_events")
}
